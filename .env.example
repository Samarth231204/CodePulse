# Database configuration
POSTGRES_USER=codepulse_user
POSTGRES_PASSWORD=codepulse_password
POSTGRES_DB=codepulse_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database URL
# For local running outside docker, host can be localhost
DATABASE_URL=postgresql://codepulse_user:codepulse_password@db:5432/codepulse_dev

# Backend Configuration
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
